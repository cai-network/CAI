# CAI Compute Chain environment template.
# Copy this file to .env for local operator setup.
# Do not put real secrets, seed phrases, private keys, SSH credentials or API tokens here.

# Network selection.
CAI_CHAIN_NETWORK=mainnet

# Local runtime state. Keep these directories out of Git.
CAI_HOME=.cai
CAI_WALLET_HOME=.cai

# Node roles. A normal user node should keep worker and validator disabled.
CAI_WORKER_ENABLED=0
CAI_VALIDATOR_ENABLED=0
CAI_RELAY_ENABLED=1

# Network/bootstrap settings.
CAI_BOOTSTRAP_PEERS=
CAI_PUBLIC_BASE_URL=
CAI_API_BIND_HOST=127.0.0.1
CAI_API_PORT=52415

# API auth. Put the real token in the ignored .cai-api-token file or a local secret manager.
CAI_API_TOKEN_FILE=.cai-api-token

# Default private network model. The repo id can change later, but Qwen/Qwen3-0.6B-GGUF is not the CAI default.
CAI_MODEL_ID=cai-network/Qwen3-0.6B-GGUF
CAI_PRIVATE_MODEL_ID=cai-network/Qwen3-0.6B-GGUF

# Auto-update from GitHub or validator channel.
CAI_AUTO_UPDATE=1
CAI_UPDATE_CHANNEL=auto
CAI_UPDATE_GITHUB_REPOSITORY=owner/repo
CAI_UPDATE_GITHUB_BRANCH=main
CAI_REQUIRE_SIGNED_UPDATES=1

# Release metadata/signature verification.
CAI_REQUIRE_SIGNED_RELEASES=1
CAI_RELEASE_TRUSTED_PUBLIC_KEYS_B64=

# Optional local live stand inventory. The real file must stay under .cai-local/secrets.
CAI_LIVE_STAND_INVENTORY=.cai-local/secrets/live-stand-access.json
