+namespace {
+
+static bool cai_env_enabled(const char * name) {
+    const char * value = std::getenv(name);
+    if (value == nullptr) {
+        return false;
+    }
+    return value[0] != '\0' && value[0] != '0';
+}
+
+static int cai_env_i32(const char * name, int fallback) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return fallback;
+    }
+
+    char * end = nullptr;
+    const long parsed = std::strtol(value, &end, 10);
+    if (end == value) {
+        return fallback;
+    }
+    if (parsed < 0) {
+        return 0;
+    }
+    if (parsed > 2147483647L) {
+        return 2147483647;
+    }
+    return static_cast<int>(parsed);
+}
+
+} // namespace
